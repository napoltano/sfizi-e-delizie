rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo gli account elencati qui possono leggere e modificare i dati del negozio.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['TUA-EMAIL@esempio.it'];
    }
  }
}
