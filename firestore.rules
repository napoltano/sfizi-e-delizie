rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo l'utente Armens (armens@sfizi-e-delizie.app) può leggere e modificare i dati del negozio.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['armens@sfizi-e-delizie.app'];
    }
  }
}
